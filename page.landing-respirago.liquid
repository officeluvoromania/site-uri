{% layout none %}
<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>RespiraGo — Nebulizator Portabil MicroMist CleanFlow™</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
:root{
  --dk:    #0A2540;
  --mid:   #0E3A6E;
  --gold:  #BF8C2E;
  --cream: #FAF8F4;
  --cream2:#F0ECE4;
  --white: #FFFFFF;
  --text:  #1A1A1A;
  --muted: #6B6560;
  --light: #A8A09A;
  --bdr:   #E8E0D4;
  --bdr2:  #D8D0C4;
  --green: #2E7D32;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:#fff;color:var(--text);-webkit-font-smoothing:antialiased;font-size:14px;line-height:1.6}
img{display:block;max-width:100%;object-fit:cover}
a{text-decoration:none;color:inherit}
button{font-family:inherit;cursor:pointer;background:none;border:none}

/* PLACEHOLDER */
.ph{background:#EEEBE5;border:1.5px dashed #C4BDB4;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;color:#9E9890;font-family:'Inter',sans-serif;font-size:10px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;text-align:center;padding:12px;position:relative}
.ph svg{opacity:.4}
.ph-label{opacity:.7;line-height:1.4;padding:0 8px}

/* FADE */
.fade{opacity:0;transform:translateY(14px);transition:opacity .55s ease,transform .55s ease}
.fade.in{opacity:1;transform:none}

/* ══ OFFER BAR ══ */
.obar{background:var(--dk);padding:9px 14px}
.obar-in{max-width:480px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:8px}
.obar-left{display:flex;flex-direction:column;gap:1px}
.obar-tag{display:flex;align-items:center;gap:5px;font-size:10px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
.obar-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0}
.obar-sub{font-size:10px;color:rgba(255,255,255,.55)}
.obar-right{display:flex;align-items:center;gap:8px;flex-shrink:0}
.obar-cd{display:flex;align-items:center;gap:2px}
.cd-u{display:flex;flex-direction:column;align-items:center}
.cd-n{font-size:15px;font-weight:700;color:#fff;background:rgba(255,255,255,.1);border-radius:3px;padding:1px 5px;min-width:24px;text-align:center;line-height:1.3}
.cd-l{font-size:7px;font-weight:500;letter-spacing:.07em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-top:1px}
.cd-sep{font-size:13px;color:rgba(255,255,255,.3);margin-bottom:5px;padding:0 1px}
.claim-btn{border:1.5px solid rgba(255,255,255,.35);color:#fff;font-size:9px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:6px 10px;border-radius:4px;white-space:nowrap;background:rgba(255,255,255,.08);flex-shrink:0}

/* ══ NAV ══ */
.nav{position:sticky;top:0;z-index:100;background:#fff;border-bottom:1px solid var(--bdr)}
.nav-in{max-width:480px;margin:0 auto;height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 14px}
.nav-icon{display:flex;align-items:center;padding:6px;color:var(--dk);position:relative}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:600;letter-spacing:.3em;color:var(--dk)}
.cart-n{position:absolute;top:2px;right:2px;width:14px;height:14px;background:var(--dk);color:#fff;border-radius:50%;font-size:8px;font-weight:700;display:flex;align-items:center;justify-content:center}

/* ══ HERO ══ */
.hero{position:relative;background:#D8DFE8}
.hero-img{width:100%;aspect-ratio:1/1;display:block;object-fit:cover}
.hero-ov{position:absolute;inset:0;background:linear-gradient(100deg,rgba(10,37,64,.82) 0%,rgba(10,37,64,.5) 48%,rgba(10,37,64,.08) 100%)}
.hero-body{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:22px 18px;z-index:2}
.hero-clin{display:inline-flex;align-items:flex-start;gap:7px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);backdrop-filter:blur(8px);border-radius:4px;padding:6px 10px;margin-bottom:14px;max-width:240px}
.hero-clin-ico{flex-shrink:0;margin-top:1px;opacity:.9}
.hero-clin-txt{font-size:10px;color:#fff;line-height:1.4}
.hero-clin-txt strong{color:var(--gold);font-weight:600}
.hero-h1{font-family:'Cormorant Garamond',serif;font-size:34px;font-weight:600;line-height:1.1;color:#fff;margin-bottom:10px}
.hero-h1 em{font-style:normal;color:var(--gold)}
.hero-sub{font-size:13px;color:rgba(255,255,255,.78);line-height:1.55;max-width:240px}
.hero-cert{position:absolute;bottom:14px;left:14px;z-index:3;background:rgba(255,255,255,.93);border-radius:6px;padding:6px 10px;display:flex;align-items:center;gap:7px}
.hero-cert-ico{flex-shrink:0;color:var(--dk)}
.hero-cert-txt{font-size:9px;font-weight:700;color:var(--dk);line-height:1.3;text-transform:uppercase;letter-spacing:.05em}

/* ══ THUMBNAILS ══ */
.thumbs{background:#fff;border-bottom:1px solid var(--bdr);padding:8px 10px;display:flex;align-items:center;gap:6px}
.thumbs-row{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;flex:1}
.thumbs-row::-webkit-scrollbar{display:none}
.thumb{width:62px;height:62px;flex-shrink:0;border-radius:5px;border:2px solid var(--bdr);overflow:hidden;cursor:pointer;transition:border-color .2s;background:#eee}
.thumb img,.thumb-ph{width:100%;height:100%;object-fit:cover}
.thumb.active{border-color:var(--dk)}
.t-arr{color:var(--dk);display:flex;align-items:center;padding:4px;opacity:.6}

.kit-link{text-align:center;padding:11px 16px;background:#fff;border-bottom:1px solid var(--bdr)}
.kit-link a{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--dk);font-weight:500;border-bottom:1px solid var(--dk)}

/* ══ RATING ══ */
.rating{display:flex;align-items:center;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid var(--bdr);background:#fff;gap:0;font-size:12px}
.r-stars{color:#D4A017;letter-spacing:.5px;font-size:13px}
.r-score{font-weight:700;color:var(--text);margin-left:5px}
.r-pipe{color:var(--light);margin:0 8px;font-size:10px}
.r-link{color:var(--dk);font-weight:500;border-bottom:1px solid currentColor}
.r-ct{color:var(--muted)}

/* ══ PRODUCT INFO ══ */
.pinfo{padding:16px 16px 4px;background:#fff}
.p-tag{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
.p-title{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:600;line-height:1.18;color:var(--dk);margin-bottom:8px}
.p-desc{font-size:13px;color:var(--muted);line-height:1.65;margin-bottom:14px}
.cpills{display:flex;flex-direction:column;gap:7px;padding-bottom:16px}
.cpill{display:flex;align-items:center;gap:9px;padding:9px 13px;border:1.5px solid var(--bdr);border-radius:6px;font-size:13px;color:var(--text);background:#fff}
.cpill-ck{flex-shrink:0;color:var(--dk)}

/* ══ VARIANT SELECTOR ══ */
.variant-section{padding:0 16px 16px;background:#fff;border-bottom:1px solid var(--bdr)}
.vsec-lbl{font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
.variants{display:flex;gap:12px}
.variant{display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer}
.variant-circle{width:80px;height:80px;border-radius:50%;border:2px solid var(--bdr);overflow:hidden;transition:border-color .2s,box-shadow .2s;background:var(--cream2);display:flex;align-items:center;justify-content:center}
.variant.active .variant-circle{border-color:var(--dk);box-shadow:0 0 0 2px var(--dk)}
.variant-circle img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.variant-circle.ph-v{border-style:dashed;border-color:#C4BDB4}
.variant-name{font-size:10px;font-weight:600;color:var(--text);text-align:center;line-height:1.3}
.variant.active .variant-name{color:var(--dk)}
.variant-badge{font-size:9px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;background:var(--dk);color:#fff;padding:2px 7px;border-radius:100px}

/* ══ PACKAGE SELECTOR ══ */
.pkg-sec{padding:16px 16px 6px;background:#fff}
.pkg-lbl{font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.pkg{border:2px solid var(--bdr);border-radius:8px;margin-bottom:8px;overflow:hidden;cursor:pointer;transition:border-color .2s;position:relative;background:#fff}
.pkg.active{border-color:var(--dk)}
.pkg-hdr{display:flex;align-items:center;gap:10px;padding:13px 14px}
.pkg-rb{width:18px;height:18px;flex-shrink:0;border:2px solid var(--bdr);border-radius:50%;display:flex;align-items:center;justify-content:center;transition:all .2s}
.pkg.active .pkg-rb{border-color:var(--dk);background:var(--dk)}
.pkg-rbd{width:6px;height:6px;border-radius:50%;background:#fff;opacity:0}
.pkg.active .pkg-rbd{opacity:1}
.pkg-meta{flex:1}
.pkg-nr{display:flex;align-items:center;gap:7px;margin-bottom:2px}
.pkg-name{font-size:14px;font-weight:600;color:var(--text)}
.pkg-badge{background:var(--gold);color:#fff;font-size:9px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:2px 7px;border-radius:100px}
.pkg-sub{font-size:11px;color:var(--muted)}
.pkg-price-area{text-align:right;flex-shrink:0}
.pkg-price{font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:600;color:var(--dk);line-height:1}
.pkg-price-unit{font-size:10px;color:var(--muted);margin-top:2px;text-align:right}
.pkg-price-old{font-size:11px;color:var(--light);text-decoration:line-through;margin-top:1px}
.pkg-corner{position:absolute;top:0;right:0;background:var(--dk);color:#fff;font-size:8px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:4px 12px 4px 16px;clip-path:polygon(10px 0%,100% 0%,100% 100%,0% 100%)}
.pkg-body{border-top:1px solid var(--bdr);padding:10px 14px 13px}
.pkg-benefs{display:flex;flex-direction:column;gap:5px;margin-bottom:10px}
.pkg-benef{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:var(--text)}
.pkg-benef-ck{flex-shrink:0;margin-top:1px;color:var(--dk)}
.wk-lbl{font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.wk-row{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.wk-row::-webkit-scrollbar{display:none}
.wk-item{flex-shrink:0;text-align:center;width:68px}
.wk-img{width:68px;height:68px;border-radius:7px;background:var(--cream2);border:1.5px solid var(--bdr);overflow:hidden;margin-bottom:3px}
.wk-img img{width:100%;height:100%}
.wk-p-old{font-size:9px;color:var(--light);text-decoration:line-through;display:block}
.wk-name{font-size:9px;color:var(--text);font-weight:500;line-height:1.3;margin-top:1px}
.pkg-future{display:flex;align-items:center;justify-content:center;gap:5px;width:100%;border-top:1px solid var(--bdr);padding:8px 14px;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--dk);margin-top:8px;background:none}

.otp{text-align:center;padding:8px 0 4px;font-size:13px;color:var(--muted)}
.otp a{color:var(--dk);border-bottom:1px solid var(--dk)}

/* ══ ATC ══ */
.atc-wrap{padding:0 16px 6px;background:#fff}
.atc-btn{display:block;width:100%;background:var(--dk);color:#fff;font-family:'Inter',sans-serif;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:17px;border:none;border-radius:6px;text-align:center;transition:background .2s}
.atc-btn:hover{background:var(--mid)}
.atc-hint{text-align:center;font-size:11px;color:var(--light);padding:7px 16px 14px;background:#fff}

/* ══ CLINICIANS ══ */
.clin{padding:14px 16px;background:#fff;border-top:1px solid var(--bdr)}
.clin-in{display:flex;gap:11px;align-items:flex-start}
.clin-badge{display:flex;flex-direction:column;align-items:center;gap:2px;flex-shrink:0;padding:5px 8px;border:1.5px solid var(--bdr);border-radius:6px;min-width:58px;background:var(--cream)}
.clin-ico{color:var(--dk);margin-bottom:1px}
.clin-badge-txt{font-size:8px;font-weight:700;color:var(--dk);letter-spacing:.05em;text-transform:uppercase;line-height:1.2;text-align:center}
.clin-right{flex:1}
.clin-txt{font-size:12px;color:var(--text);line-height:1.55}
.clin-avs{display:flex;margin:5px 0 3px}
.clin-av{width:22px;height:22px;border-radius:50%;border:2px solid #fff;margin-left:-5px;object-fit:cover;background:var(--cream2);overflow:hidden}
.clin-av:first-child{margin-left:0}
.clin-link{font-size:11px;color:var(--dk);font-weight:500;border-bottom:1px solid var(--dk)}

/* ══ GIVES BACK ══ */
.gb{margin:0 16px 14px;background:var(--cream);border:1.5px solid var(--bdr);border-radius:8px;padding:12px 13px;display:flex;gap:11px;align-items:flex-start}
.gb-ico{width:30px;height:30px;flex-shrink:0;background:#fff;border-radius:50%;border:1.5px solid var(--bdr);display:flex;align-items:center;justify-content:center;color:var(--dk)}
.gb-txt{font-size:12px;color:var(--text);line-height:1.6}

/* ══ TRUST ══ */
.trust{display:flex;justify-content:space-around;padding:14px 10px;border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr);background:#fff}
.ti{display:flex;flex-direction:column;align-items:center;gap:6px;flex:1}
.ti-icon{width:40px;height:40px;border:1.5px solid var(--bdr);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--dk)}
.ti-lbl{font-size:10px;font-weight:600;color:var(--dk);text-align:center;line-height:1.3}

/* ══ WHAT YOU'LL FEEL ══ */
.wyf{padding:22px 16px;background:var(--cream)}
.wyf-title{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:600;text-align:center;color:var(--dk);margin-bottom:14px}
.wyf-row{display:flex;align-items:center;gap:11px;padding:12px 0;border-bottom:1px solid var(--bdr)}
.wyf-row:last-child{border-bottom:none}
.wyf-ico{width:36px;height:36px;flex-shrink:0;border-radius:50%;background:#fff;border:1.5px solid var(--bdr);display:flex;align-items:center;justify-content:center;color:var(--dk)}
.wyf-info{flex:1}
.wyf-name{font-size:13px;font-weight:600;color:var(--text)}
.wyf-sub{font-size:11px;color:var(--muted);margin-top:1px}
.wyf-pct{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:600;color:var(--dk);flex-shrink:0}

/* ══ TRANSFORM ══ */
.tfm{padding:24px 16px;background:#fff;border-top:1px solid var(--bdr);text-align:center}
.tfm-pill{display:inline-block;background:var(--gold);color:#fff;font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;border-radius:100px;padding:4px 14px;margin-bottom:11px}
.tfm-title{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:600;color:var(--dk);line-height:1.2;margin-bottom:7px}
.tfm-sub{font-size:13px;color:var(--muted);line-height:1.6;margin-bottom:16px}
.exp-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;text-align:left}
.exp-card{border:1.5px solid var(--bdr);border-radius:8px;overflow:hidden}
.exp-photo{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}
.exp-photo.ph{aspect-ratio:3/4}
.exp-body{padding:8px 10px}
.exp-name{font-size:12px;font-weight:600;color:var(--dk)}
.exp-role{font-size:10px;color:var(--muted);line-height:1.35;margin-top:2px}
.tfm-desc{font-size:12px;color:var(--muted);line-height:1.65;margin-bottom:14px}
.tfm-btn{display:block;width:100%;border:1.5px solid var(--dk);color:var(--dk);font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;padding:13px;border-radius:6px;background:none;transition:all .2s}
.tfm-btn:hover{background:var(--dk);color:#fff}

/* ══ ACCORDION ══ */
.acc-sec{background:#fff;border-top:1px solid var(--bdr);border-bottom:1px solid var(--bdr)}
.acc-item{border-bottom:1px solid var(--bdr)}
.acc-item:last-child{border-bottom:none}
.acc-btn{width:100%;display:flex;align-items:center;justify-content:space-between;padding:16px;gap:12px;text-align:left;background:none;border:none}
.acc-txt{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:600;color:var(--text)}
.acc-ico{width:22px;height:22px;flex-shrink:0;border-radius:50%;border:1.5px solid var(--bdr);display:flex;align-items:center;justify-content:center;transition:transform .3s,background .2s;color:var(--dk);font-size:14px;line-height:1;font-family:sans-serif;font-weight:300}
.acc-item.open .acc-ico{transform:rotate(45deg);background:var(--dk);border-color:var(--dk);color:#fff}
.acc-body{max-height:0;overflow:hidden;transition:max-height .38s cubic-bezier(.4,0,.2,1)}
.acc-body-in{padding:0 16px 16px;font-size:13px;color:var(--muted);line-height:1.75}
.acc-item.open .acc-body{max-height:800px}
.acc-body-in ul{padding-left:18px}
.acc-body-in li{margin-bottom:6px}
.acc-body-in strong{color:var(--dk);font-weight:600}

/* ══ AMBASSADORS ══ */
.amb{padding:24px 0;background:var(--cream);border-top:1px solid var(--bdr)}
.amb-hdr{padding:0 16px 14px}
.amb-sec-tag{font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.amb-title{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:600;color:var(--dk)}
.amb-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:0 16px}
.amb-card{border-radius:8px;overflow:hidden;position:relative;cursor:pointer}
.amb-img{width:100%;aspect-ratio:9/16;object-fit:cover;display:block}
.amb-img.ph{aspect-ratio:9/16}
.amb-ov{position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(0,0,0,.58) 100%)}
.amb-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:40px;height:40px;background:rgba(255,255,255,.18);border:2px solid rgba(255,255,255,.5);border-radius:50%;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px)}
.amb-info{position:absolute;bottom:8px;left:9px;right:9px}
.amb-name{font-size:10px;font-weight:700;color:#fff}
.amb-city{font-size:8.5px;color:rgba(255,255,255,.7)}
.amb-rb{position:absolute;top:8px;left:8px;background:rgba(185,25,25,.9);color:#fff;font-size:7px;font-weight:700;padding:2px 5px;border-radius:3px;letter-spacing:.05em}

/* ══ TRUSTED DARK ══ */
.trusted{background:var(--dk);padding:26px 0;overflow:hidden}
.trusted-hdr{padding:0 16px 18px;text-align:center}
.trusted-pill{display:inline-flex;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.85);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;border-radius:100px;padding:5px 14px;margin-bottom:13px}
.trusted-h{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:600;color:#fff;line-height:1.18;margin-bottom:5px}
.trusted-it{font-family:'Cormorant Garamond',serif;font-size:21px;font-style:italic;color:var(--gold);line-height:1.2}
.t-scroll{display:flex;gap:10px;padding:0 16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none}
.t-scroll::-webkit-scrollbar{display:none}
.t-card{min-width:220px;max-width:220px;scroll-snap-align:start;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:10px;overflow:hidden;flex-shrink:0}
.t-photo{width:100%;height:196px;object-fit:cover;display:block}
.t-photo.ph{height:196px}
.t-body{padding:12px}
.t-name{font-size:13px;font-weight:600;color:#fff;margin-bottom:2px}
.t-loc{font-size:10px;color:rgba(255,255,255,.55);margin-bottom:7px}
