<script>
/* COUNTDOWN */
(function(){
  const end = Date.now()+(8*3600+47*60+23)*1000;
  function tick(){
    const d=Math.max(0,end-Date.now());
    const h=Math.floor(d/3600000),m=Math.floor((d%3600000)/60000),s=Math.floor((d%60000)/1000);
    document.getElementById('cd-h').textContent=String(h).padStart(2,'0');
    document.getElementById('cd-m').textContent=String(m).padStart(2,'0');
    document.getElementById('cd-s').textContent=String(s).padStart(2,'0');
    if(d>0)setTimeout(tick,1000);
  }
  tick();
})();

/* THUMBNAILS */
function selThumb(el,src){
  document.querySelectorAll('.thumb').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('hero-img').src=src;
}
function shiftThumbs(dir){
  document.getElementById('thumbs-row').scrollBy({left:dir*130,behavior:'smooth'});
}

/* VARIANTS */
function selVariant(el,idx,name,price){
  document.querySelectorAll('.variant').forEach(v=>v.classList.remove('active'));
  el.classList.add('active');
  // also select matching pkg
  if(idx===2) selPkg(0);
  else if(idx===1) selPkg(1);
  else selOtp();
  updateCTA(name,price);
}

/* PACKAGES */
const pkgData=[
  {name:'3x Pachet Familial (Save 30%)',price:'249',per:'83 lei / aparat'},
  {name:'2x Acasă + Bunici (Save 20%)',price:'199',per:'99 lei / aparat'},
  {name:'1x RespiraGo Acasă',price:'149',per:'149 lei / aparat'}
];
let curPkg=0;

function selPkg(idx){
  curPkg=idx;
  document.querySelectorAll('#pkgs .pkg').forEach((p,i)=>p.classList.toggle('active',i===idx));
  updateCTA(pkgData[idx].name,pkgData[idx].price,pkgData[idx].per);
}
function selOtp(){
  curPkg=2;
  document.querySelectorAll('#pkgs .pkg').forEach(p=>p.classList.remove('active'));
  updateCTA(pkgData[2].name,pkgData[2].price,pkgData[2].per);
}
function updateCTA(name,price,per){
  document.getElementById('atc-btn').textContent=`ADAUGĂ ÎN COȘ — ${price} LEI`;
  document.getElementById('fcta-btn').textContent=`COMANDĂ ACUM — ${price} LEI`;
  document.getElementById('sbar-name').textContent=name;
  if(per) document.getElementById('sbar-price').textContent=per;
}
function selFPkg(el,name,price){
  document.querySelectorAll('#fpkgs .fpkg').forEach(f=>f.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('fcta-btn').textContent=`COMANDĂ ACUM — ${price} LEI`;
  document.getElementById('atc-btn').textContent=`ADAUGĂ ÎN COȘ — ${price} LEI`;
  document.getElementById('sbar-name').textContent=name;
}

/* CART */
function addToCart(){
  const n=document.getElementById('cart-n');
  n.textContent=parseInt(n.textContent)+1;
  const btn=document.getElementById('atc-btn');
  const orig=btn.textContent;
  btn.style.background='#2E7D32';
  btn.textContent='✓ Adăugat în coș!';
  setTimeout(()=>{btn.style.background='';btn.textContent=orig;},2200);
}

/* ACCORDION */
function togAcc(btn){
  const item=btn.closest('.acc-item');
  const was=item.classList.contains('open');
  document.querySelectorAll('.acc-item').forEach(i=>i.classList.remove('open'));
  if(!was)item.classList.add('open');
}

/* TRUSTED DOTS */
function tGo(n){
  document.querySelectorAll('#t-dots .t-dot').forEach((d,i)=>d.classList.toggle('active',i===n));
  const sc=document.getElementById('t-scroll');
  const w=sc.querySelector('.t-card').offsetWidth+10;
  sc.scrollTo({left:n*w,behavior:'smooth'});
}

/* STICKY */
const sbar=document.getElementById('sbar');
const atcBtn=document.getElementById('atc-btn');
const obs=new IntersectionObserver(e=>{
  sbar.classList.toggle('show',!e[0].isIntersecting);
},{threshold:0});
if(atcBtn)obs.observe(atcBtn);

/* FADE */
const fObs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('in');});
},{threshold:0.07});
document.querySelectorAll('.fade').forEach(el=>fObs.observe(el));
</script>
